+// contact forces recomputed at a Runge-Kutta stage: the stage positions of the free points
+// (fixed points stay where they are), the finite-difference velocities as at the step start;
+// afterwards the tree boxes are restored to the step-start positions.
+void PhysicsEngine::resolve_collisions_at_stage(Ref<Matrix <double, 2, Dynamic>> stage_pos) {
+	Matrix <double, 2, Dynamic> start_pos = *pos;
+	*pos = fixed->select(start_pos, stage_pos);
+	resolve_collisions();
+	*pos = start_pos;
+	for (int i = 0; i < objects->size(); i++)
+		objects->at(i)->recompute_bbs(*pos);
+}
