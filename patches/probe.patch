+// probe: counts robot points inside fixed terrain that receive no contact force; it changes no arithmetic
+static std::vector<int> probe_applied;
+static std::vector<double> probe_missed;
+static long probe_point_steps = 0, probe_pairs = 0;
+static double probe_depth = 0.0;
+extern "C" __attribute__((visibility("default"))) void evogym_probe_read(long* point_steps, double* depth, long* pairs) {
+	*point_steps = probe_point_steps; *depth = probe_depth; *pairs = probe_pairs;
+}
+extern "C" __attribute__((visibility("default"))) void evogym_probe_reset() {
+	probe_point_steps = 0; probe_pairs = 0; probe_depth = 0.0;
+}
 
